{
  "name": "@iyulab/modern-app",
  "description": "web-framework by iyulab based on react, lit-element",
  "version": "0.3.0",
  "keywords": [
    "iyulab",
    "web-framework",
    "react",
    "lit-element"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-modern-app.git"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./dist/*": {
      "types": "./src/*.d.ts",
      "import": "./src/*"
    }
  },
  "scripts": {
    "test": "vite",
    "build": "vite build"
  },
  "dependencies": {
    "@iyulab/components": "^0.3.0",
    "@iyulab/router": "^0.7.2",
    "i18next": "^25.8.13",
    "lit": "^3.3.2",
    "quill": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  }
}