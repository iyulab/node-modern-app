{
  "name": "@iyulab/modern-app",
  "description": "web-framework by iyulab, react and lit-element",
  "version": "0.1.63",
  "author": {
    "name": "iyulab",
    "url": "https://www.iyulab.com"
  },
  "homepage": "https://www.iyulab.com",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "src/index.d.ts",
  "scripts": {
    "test": "vite",
    "scan": "i18next -c i18next.config.js",
    "build": "iyulab build -d dist -b vite",
    "deploy": "iyulab publish"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "require": "./src/index.js",
      "import": "./src/index.js"
    },
    "./styles/*": {
      "import": "./static/styles/*"
    },
    "./apps": {
      "types": "./src/apps/index.d.ts",
      "require": "./src/apps/index.js",
      "import": "./src/apps/index.js"
    },
    "./components": {
      "types": "./src/components/index.d.ts",
      "require": "./src/components/index.js",
      "import": "./src/components/index.js"
    },
    "./components/dx": {
      "types": "./src/components/dx/index.d.ts",
      "require": "./src/components/dx/index.js",
      "import": "./src/components/dx/index.js"
    },
    "./components/controls": {
      "types": "./src/components/controls/index.d.ts",
      "require": "./src/components/controls/index.js",
      "import": "./src/components/controls/index.js"
    },
    "./components/mixin": {
      "types": "./src/components/mixin/index.d.ts",
      "require": "./src/components/mixin/index.js",
      "import": "./src/components/mixin/index.js"
    },
    "./sevices": {
      "types": "./src/services/index.d.ts",
      "require": "./src/services/index.js",
      "import": "./src/services/index.js"
    },
    "./settings": {
      "types": "./src/settings/index.d.ts",
      "require": "./src/settings/index.js",
      "import": "./src/settings/index.js"
    }
  },
  "dependencies": {
    "@iyulab/components": "^0.0.2",
    "@lit/react": "^1.0.7",
    "lit": "^3.3.0",
    "mobx": "^6.13.7",
    "mobx-react": "^9.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@adobe/lit-mobx": "^2.2.2",
    "@iyulab/utils": "^0.0.9",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "axios": "^1.9.0",
    "devextreme": "^24.2.6",
    "devextreme-react": "^24.2.6",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "i18next-parser": "^9.3.0",
    "jspdf": "^3.0.1",
    "postcss": "^8.5.3",
    "postcss-nesting": "^13.0.1",
    "sass": "^1.87.0",
    "sass-loader": "^16.0.5",
    "shx": "^0.4.0",
    "tailwindcss": "4.1.4",
    "typescript": "^5.8.3",
    "urlpattern-polyfill": "^10.0.0",
    "vite": "^6.3.4",
    "vite-plugin-dts": "^4.5.3"
  }
}
