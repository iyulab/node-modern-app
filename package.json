{
  "name": "@iyulab/modern-app",
  "description": "Application shell for Lit web apps: layout, sidebar, command palette, routing and app lifecycle",
  "version": "0.63.0",
  "keywords": [
    "iyulab",
    "web-framework",
    "lit-element"
  ],
  "license": "MIT",
  "author": "iyulab",
  "repository": {
    "type": "git",
    "url": "https://github.com/iyulab/node-modern-app.git"
  },
  "files": [
    "dist",
    "skills",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "customElements": "./dist/custom-elements.json",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "./dist/components/*.js",
    "./src/components/*.ts",
    "./dist/index.js",
    "./src/index.ts",
    "./dist/layouts/*.js",
    "./src/layouts/*.ts",
    "./dist/react.js",
    "./src/react.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./react": "./dist/react/index.js",
    "./react/*": "./dist/react/*",
    "./dist/*": {
      "types": "./src/*.d.ts",
      "import": "./src/*"
    }
  },
  "scripts": {
    "preversion": "node -e \"if(require('fs').existsSync('../../scripts/preversion-check.mjs'))require('child_process').execFileSync('node',['../../scripts/preversion-check.mjs'],{stdio:'inherit'})\"",
    "pretest": "node -e \"if(require('fs').existsSync('../../scripts/sibling-dist-check.js'))require('child_process').execFileSync('node',['../../scripts/sibling-dist-check.js'],{stdio:'inherit'})\"",
    "test": "vitest run --project=unit --project=browser",
    "test:webkit": "vitest run --project=webkit",
    "test:watch": "vitest",
    "start": "vite",
    "analyze": "cem analyze",
    "build": "npm run typecheck && npm run lint && vite build && npm run analyze && npm run test:react-types",
    "test:browser": "vitest run --project=browser",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test:react-types": "tsc -p tsconfig.react-smoke.json"
  },
  "dependencies": {
    "i18next": "^27.1.3",
    "lit": "^3.3.3"
  },
  "peerDependencies": {
    "@iyulab/components": ">=3.2.0",
    "@iyulab/router": "^0.25.0",
    "@lit/react": "^1.0.8",
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@lit/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@iyulab/components": "^3.0.0",
    "@iyulab/router": "^0.25.0",
    "@lit/react": "^1.0.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^14.0.6",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
