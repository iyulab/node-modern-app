{
  "compilerOptions": {
    "target": "ES6",
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "composite": true,
    
    /* Bundler mode */
    "moduleResolution": "Node",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    
    "baseUrl": ".",
    "paths": {
      "@/*": [ "src/*" ],
      // "@iyulab/modern-app": [ "lib-src" ],
      // "@iyulab/modern-app/*": [ "lib-src/*" ],
    },
    "typeRoots": [
      "./src/declarations", 
      "./node_modules/@types"
    ]
  },
  "include": [
    "vite.config.ts",
    "src",
    //"lib-src"
  ],
}