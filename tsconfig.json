{
  "compilerOptions": {
    // 기본 컴파일러 옵션
    "target": "ESNext",
    "module": "ESNext",
    "lib": ["ESNext","DOM","DOM.Iterable"],
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",

    // 엄격한 타입 체킹
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,

    // 코드 품질 관련
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,

    // 모듈 및 호환성 설정
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // 데코레이터 지원
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    // 출력 설정
    "noEmit": true,
    
    // 기타 옵션
    "useDefineForClassFields": false,
    "skipLibCheck": true,
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "vite-env.d.ts",
    "vite.config.ts",
  ],
  // ⚠`tests/types` 는 **제외한다** — 그 스모크는 빌드 산출물(`dist/react/*.d.ts`)을 검증
  //   대상으로 삼으므로 `dist` 가 있을 때만 의미가 있고, 전용 프로젝트
  //   `tsconfig.react-smoke.json` 이 `build` 파이프라인 끝에서 돈다(`test:react-types`).
  //   여기 남겨 두면 fresh clone 의 `tsc --noEmit` 이 **거짓 실패**한다 — 그 설명은 그
  //   파일 주석에 이미 있었는데 이 `exclude` 가 그것을 지키지 않고 있었다(cycle-654).
  "exclude": [
    "node_modules",
    "dist",
    "tests/types"
  ]
}